{
  "name": "STI Light Accessible",
  "dataColors": ["#0072B2", "#A35F00", "#008060", "#7D6E00", "#C2410C", "#A8457F", "#2B6CB0", "#6B7785"],
  "background": "#FFFFFF",
  "foreground": "#1F2328",
  "tableAccent": "#0072B2",
  "good": "#008060",
  "neutral": "#A35F00",
  "bad": "#C2410C",
  "minimum": "#4F7CA3",
  "center": "#6B7785",
  "maximum": "#7D6E00",
  "null": "#6B7785",
  "hyperlink": "#0969DA",
  "visitedHyperlink": "#8250DF",
  "textClasses": {
    "title": { "fontFace": "Segoe UI Semibold", "fontSize": 14, "color": "#1F2328" },
    "label": { "fontFace": "Segoe UI", "fontSize": 11, "color": "#57606A" },
    "callout": { "fontFace": "Segoe UI Semibold", "fontSize": 32, "color": "#1F2328" }
